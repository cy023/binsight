        {
          "name": "SEQ",
          "offset": 4,
          "size": 4,
          "type": "uint",
          "description": "Sequence Number"
        },
        {
          "name": "TIMESTAMP_US",
          "offset": 8,
          "size": 8,
          "type": "uint",
          "unit": "us",
          "description": "Timestamp (us)"

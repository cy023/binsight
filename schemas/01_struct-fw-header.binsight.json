{
  "id": "builtin-struct-fw-header",
  "schemaVersion": "1.0",
  "mode": "struct-list",
  "name": "FW_IMAGE_HEADER (Struct List)",
  "description": "Fixed Firmware Image Header & Boot Descriptor Struct",
  "endianness": "little",
  "baseAddress": "0x00000000",
  "fields": [
    {
      "name": "MAGIC",
      "offset": "0x00",
      "size": 4,
      "type": "ascii",
      "description": "Image magic signature (e.g. \"FWIM\")"
    },
    {
      "name": "FORMAT_VER",
      "offset": "0x04",
      "size": 2,
      "type": "hex",
      "description": "Header format version (Major.Minor)"
    },
    {
      "name": "FLAGS",
      "offset": "0x06",
      "size": 2,
      "type": "hex",
      "description": "Boot flags (bit0=Secure, bit1=Compressed)"
    },
    {
      "name": "LOAD_ADDR",
      "offset": "0x08",
      "size": 4,
      "type": "hex",
      "description": "Target SRAM/DRAM load address"
    },
    {
      "name": "ENTRY_POINT",
      "offset": "0x0C",
      "size": 4,
      "type": "hex",
      "description": "CPU reset vector entry point"
    },
    {
      "name": "PAYLOAD_SIZE",
      "offset": "0x10",
      "size": 4,
      "type": "uint",
      "unit": "bytes",
      "description": "Firmware payload length in bytes"
    },
    {
      "name": "BUILD_EPOCH",
      "offset": "0x14",
      "size": 4,
      "type": "uint",
      "description": "Unix build timestamp"
    },
    {
      "name": "CRC32",
      "offset": "0x18",
      "size": 4,
      "type": "hex",
      "description": "Payload CRC-32 checksum"
    },
    {
      "name": "IMAGE_TAG",
      "offset": "0x1C",
      "size": 8,
      "type": "ascii",
      "description": "8-byte firmware build tag"
    }
  ]
}
